# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Optional explicit production domain for SEO canonicals, sitemap.xml, and robots.txt.
# On Netlify builds, Netlify's built-in URL environment variable is used automatically if this is omitted.
VITE_SITE_URL="https://osamanursamsil.netlify.app"

# =============================================================================
# GOOGLE DRIVE OAUTH 2.0 & NETLIFY FUNCTIONS (SERVER-ONLY — NEVER PREFIX VITE_)
# Configure these variables in Netlify Site Configuration -> Environment Variables
# =============================================================================

# Google Cloud OAuth 2.0 Web Application Client ID
GOOGLE_DRIVE_CLIENT_ID=""

# Google Cloud OAuth 2.0 Web Application Client Secret (server-only)
GOOGLE_DRIVE_CLIENT_SECRET=""

# Optional explicit OAuth callback URI (defaults to <Netlify Site URL>/.netlify/functions/gdrive-oauth-callback)
GOOGLE_DRIVE_REDIRECT_URI=""

# 32-byte encryption key for AES-256-GCM refresh token storage (generate with: openssl rand -hex 32)
GDRIVE_TOKEN_ENCRYPTION_KEY=""

# Single authorized owner Google email allowed to connect Google Drive & upload files
GOOGLE_DRIVE_OWNER_EMAIL="osamanursamsil@gmail.com"

# Firebase Project ID used to cryptographically verify Firebase Auth ID tokens
FIREBASE_PROJECT_ID="premium-generator-4lxdt"
